{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jotaro.local/schemas/prompt-manifest.schema.json",
  "title": "Jotaro Jotaro 0.8 prompt manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "generation_id",
    "model_target",
    "aspect_ratio",
    "duration_seconds",
    "primary_metric",
    "brief_hash",
    "identity_hash",
    "specialist_reviews_hash",
    "scenes",
    "shots"
  ],
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "generation_id": { "type": "string", "minLength": 10 },
    "model_target": {
      "type": "string",
      "enum": ["kling3_0", "seedance_2_0_mini", "seedance_2_0", "nano_banana_2", "soul_cinematic"]
    },
    "aspect_ratio": {
      "type": "string",
      "enum": ["9:16", "16:9", "1:1", "4:5"]
    },
    "duration_seconds": { "type": "number", "minimum": 4, "maximum": 60 },
    "primary_metric": {
      "type": "string",
      "enum": ["hook_rate", "hold_rate", "vcr", "ctr", "cpa", "roas", "qualidade_visual"]
    },
    "brief_hash": { "type": "string", "minLength": 8 },
    "identity_hash": { "type": "string", "minLength": 8 },
    "specialist_reviews_hash": { "type": "string", "minLength": 8 },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cena_id", "time", "beat", "cena_brief", "shot_ids"],
        "properties": {
          "cena_id": { "type": "string", "minLength": 1 },
          "time": { "type": "string", "minLength": 1 },
          "beat": { "type": "string", "enum": ["hook", "desenvolvimento", "climax", "payoff", "cta"] },
          "cena_brief": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cena_id",
              "objetivo",
              "o_que_comunica",
              "metodo_comunicacao",
              "como_comunica",
              "arco",
              "sobrevive_sozinha",
              "motivo_teste_vampiro"
            ],
            "properties": {
              "cena_id": { "type": "string", "minLength": 1 },
              "objetivo": { "type": "string", "minLength": 5 },
              "o_que_comunica": { "type": "string", "minLength": 10 },
              "metodo_comunicacao": { "type": "string", "minLength": 10 },
              "como_comunica": { "type": "string", "minLength": 10 },
              "arco": {
                "type": "object",
                "additionalProperties": false,
                "required": ["inicio", "meio", "fim"],
                "properties": {
                  "inicio": { "type": "string", "minLength": 5 },
                  "meio": { "type": "string", "minLength": 5 },
                  "fim": { "type": "string", "minLength": 5 }
                }
              },
              "sobrevive_sozinha": { "type": "boolean" },
              "motivo_teste_vampiro": { "type": "string", "minLength": 10 }
            }
          },
          "shot_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cena_id", "beat", "time", "subject", "action", "world", "camera", "montagem", "realismo", "audio"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "cena_id": { "type": "string", "minLength": 1 },
          "beat": { "type": "string", "enum": ["hook", "desenvolvimento", "climax", "payoff", "cta"] },
          "time": { "type": "string", "minLength": 1 },
          "subject": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "world": { "type": "string", "minLength": 1 },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "required": ["shot_size", "angle", "movement", "lens_or_look"],
            "properties": {
              "shot_size": { "type": "string", "minLength": 1 },
              "angle": { "type": "string", "minLength": 1 },
              "movement": { "type": "string", "minLength": 1 },
              "lens_or_look": { "type": "string", "minLength": 1 }
            }
          },
          "montagem": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cut_style", "duration"],
            "properties": {
              "cut_style": { "type": "string", "minLength": 1 },
              "duration": { "type": "number", "minimum": 0.5 }
            }
          },
          "realismo": {
            "type": "object",
            "additionalProperties": false,
            "required": ["motion_blur", "imperfections"],
            "properties": {
              "motion_blur": { "type": "string" },
              "imperfections": { "type": "array", "items": { "type": "string" } }
            }
          },
          "audio": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dialogue", "music", "ambience"],
            "properties": {
              "dialogue": { "type": "string" },
              "music": { "type": "string" },
              "ambience": { "type": "string" }
            }
          }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
